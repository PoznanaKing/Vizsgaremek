              "schema": {
                "type": "object",
                "properties": {
                  "post_title": {
                    "type": "string"
                  },
                  "post_image": {
                    "type": "string",
                    "format": "binary"
                  },
                  "post_description": {
                    "type": "string"
                  },
                  "user_id": {
                    "type": "string"
                  }
                }
              },
              "encoding": {
                "post_title": {
                  "style": "form"
                },
                "post_image": {
                  "style": "form"
                },
                "post_description": {
                  "style": "form"
