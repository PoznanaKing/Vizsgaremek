<Window x:Class="PMprojectAdminPanel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PMprojectAdminPanel"
        mc:Ignorable="d"
        Title="Admin Panel" Height="600" Width="800"
        Background="#2E2E2E" Foreground="White">

    <Window.Resources>
        <!-- Gomb stílus -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#4A4A4A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <!-- Szövegdoboz stílus -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#4A4A4A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <!-- Jelszómező stílus -->
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#4A4A4A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <!-- Szövegblokk stílus -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <!-- Lista stílus -->
        <Style TargetType="ListView">
            <Setter Property="Background" Value="#4A4A4A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Bejelentkezési panel -->
        <Grid x:Name="mainGrid" Margin="20" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Admin Bejelentkezés" FontSize="20" FontWeight="Bold" Margin="0 0 0 20"/>

            <StackPanel Grid.Row="1" Orientation="Vertical" Margin="0 0 0 10">
                <TextBlock Text="Felhasználónév" Margin="0 0 0 5"/>
                <TextBox x:Name="txtUsername" Width="200"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Vertical" Margin="0 0 0 20">
                <TextBlock Text="Jelszó" Margin="0 0 0 5"/>
                <PasswordBox x:Name="txtPassword" Width="200"/>
            </StackPanel>

            <Button Grid.Row="3" x:Name="btnLogin" Content="Bejelentkezés" Width="100" 
                    Click="btnLogin_Click"/>
        </Grid>

        <!-- Admin panel -->
        <StackPanel x:Name="topPanel" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
            <DockPanel Background="#3E3E3E" Margin="0 0 0 10">
                <TextBlock x:Name="txtAdminName" Margin="10" FontWeight="Bold"/>
                <Button x:Name="btnLogout" Content="Kijelentkezés" DockPanel.Dock="Right" 
                        Margin="10" Click="btnLogout_Click"/>
            </DockPanel>

            <ListView x:Name="postsListView">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding PostTitle}"/>
                            <Button Content="Törlés" 
                        Click="DeletePost_Click"
                        Tag="{Binding}"/>
                            <!-- PostDto mentése Tag-be -->
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </Grid>
</Window>

 
