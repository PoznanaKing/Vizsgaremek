<Window x:Class="PMprojectAdminPanel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PMprojectAdminPanel"
        mc:Ignorable="d"
        Title="Admin Panel" Height="600" Width="800">
    <Grid>
        <!-- Login Panel -->
        <Grid x:Name="mainGrid" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Admin Bejelentkezés" FontSize="20" FontWeight="Bold" Margin="0 0 0 20"/>

            <StackPanel Grid.Row="1" Orientation="Vertical" Margin="0 0 0 10">
                <TextBlock Text="Felhasználónév" Margin="0 0 0 5"/>
                <TextBox x:Name="txtUsername" Width="200" HorizontalAlignment="Left"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Vertical" Margin="0 0 0 20">
                <TextBlock Text="Jelszó" Margin="0 0 0 5"/>
                <PasswordBox x:Name="txtPassword" Width="200" HorizontalAlignment="Left"/>
            </StackPanel>

            <Button Grid.Row="3" x:Name="btnLogin" Content="Bejelentkezés" Width="100" 
                    Click="btnLogin_Click" HorizontalAlignment="Left"/>
        </Grid>

        <!-- Admin Panel -->
        <StackPanel x:Name="topPanel" Visibility="Collapsed">
            <DockPanel Background="#EEE" Margin="0 0 0 10">
                <TextBlock x:Name="txtAdminName" Margin="10" FontWeight="Bold"/>
                <Button x:Name="btnLogout" Content="Kijelentkezés" DockPanel.Dock="Right" 
                        Margin="10" Click="btnLogout_Click"/>
            </DockPanel>

            <ListView x:Name="postsListView" Margin="10">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="10">
                            <TextBlock Text="{Binding PostTitle}" FontWeight="Bold" FontSize="14"/>
                            <TextBlock Text="{Binding PostDescription}" Margin="0 5 0 10"/>
                            <TextBlock Text="Hozzászólások:" FontWeight="Bold"/>
                            <ListView ItemsSource="{Binding PostComments}" Margin="10 5 0 0">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="5">
                                            <TextBlock Text="{Binding UserName}" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding CommentText}" Margin="5 0 0 0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </Grid>
</Window>